# SmartEye Price Manager — owner only.
# Password is managed in cPanel → Directory Privacy (public_html/calc).
# Until a user is created there, the page stays locked for everyone.
AuthType Basic
AuthName "SmartEye Price Manager"
AuthUserFile "/home/smarteye/.htpasswds/public_html/calc/passwd"
Require valid-user
Options -Indexes
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "no-referrer"
</IfModule>
